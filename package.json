{
  "name": "rewear",
  "private": true,
  "version": "0.1.0",
  "description": "ReWear: a mobile-first web app that helps Gen Z upcycle clothes they already own.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/**/*.test.js\"",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "test:e2e": "npm run build:e2e && node --test --test-concurrency=1 \"tests/e2e/**/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "heic2any": "^0.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.50.0",
    "vite": "^7.0.0"
  }
}
