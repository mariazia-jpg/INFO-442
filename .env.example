# Copy to .env.local to override locally. Nothing here is secret, and the app
# runs without any of these set.

# Path the site is served from. Leave unset for local development.
# The GitHub Pages workflow sets it to /<repo-name>/ automatically.
# VITE_BASE=/INFO-442/

# Which clothing recognizer to use. Default: gemini once FIREBASE_CONFIG is
# filled in (src/services/firebaseConfig.js), otherwise mobilenet.
#   gemini    — Gemini through Firebase AI Logic
#   mobilenet — in-browser image classifier, no photo leaves the device
#   stub      — returns VITE_STUB_RESULT, for trying screens without Firebase
#   filename  — reads the type from the file name; used by the e2e tests
# VITE_RECOGNIZER=mobilenet

# Used only when VITE_RECOGNIZER=stub: tshirt, top, pants, skirt, unknown, or
# error (simulates a failed API call).
# VITE_STUB_RESULT=tshirt
